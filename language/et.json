      "options": [
        {
          "value": "fulltext",
          "label": "Kogu tekst"
        },
        {
          "value": "marked",
          "label": "Markerite [ ] vaheline osa"
        }
      ]
    },
    {
      "name": "showEvaluatedParts",
      "type": "boolean",
      "label": "Kuva hinnatav osa helesinise taustaga",
