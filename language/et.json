          "options": [
            {
              "value": "[]",
              "label": "[ ]  –  [vastus]"
            },
            {
              "value": "{}",
              "label": "{ }  –  {vastus}"
            },
            {
              "value": "##",
              "label": "# #  –  #vastus#"
            },
            {
              "value": "@@",
              "label": "@ @  –  @vastus@"
            },
            {
              "value": "*",
              "label": "* *  –  *vastus*"
            }
          ]
        },
        {
          "name": "optionSeparator",
