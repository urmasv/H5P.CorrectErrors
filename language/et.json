      "optional": true,
      "tags": [
        "p",
        "br",
        "strong",
        "em",
        "u",
        "ul",
        "ol",
        "li",
        "a",
        "span",
        "sub",
        "sup"
      ]
    },
    {
      "name": "correctText",
      "type": "text",
