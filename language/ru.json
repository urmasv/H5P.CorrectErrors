{
  "semantics": [
    {
      "name": "taskDescription",
      "type": "text",
      "widget": "html",
      "label": "Инструкция для учащегося",
      "importance": "high",
      "default": "Исправьте текст. При необходимости замените, удалите или добавьте текст.",
      "optional": true,
      "tags": [
        "p",
        "br",
        "strong",
        "em",
        "u",
        "ul",
        "ol",
        "li",
        "a",
        "span",
        "sub",
        "sup"
      ]
    },
    {
      "name": "correctText",
      "type": "text",
      "widget": "textarea",
      "label": "Правильный текст",
      "importance": "high",
      "default": "Привет, [мир]! Можете добавить [пробелы]?",
      "description": "Введите правильный текст. Для выделения оцениваемого содержания используйте маркеры, например [ответ], [ответ|вариант] или [!!] для пустого правильного ответа. Символы маркеров не считаются частью правильного ответа."
    },
    {
      "name": "wrongText",
      "type": "text",
      "widget": "textarea",
      "label": "Текст с ошибками для учащегося",
      "importance": "high",
      "default": "Привет, [мир] Можете добавить [пробел]?",
      "optional": true
    },
    {
      "name": "specialCharacters",
      "type": "text",
      "widget": "textarea",
      "label": "Дополнительные символы",
      "importance": "high",
      "default": "",
      "optional": true,
      "description": "Введите символы, которые учащийся сможет вставлять кнопками над областью ответа. Разделяйте символы пробелами, запятыми или переносами строк."
    },
    {
      "name": "scoreMode",
      "type": "select",
      "label": "Способ оценивания",
      "importance": "high",
      "default": "fulltext",
      "description": "При выборе всего текста итоговый текст учащегося сравнивается со всем правильным текстом после удаления маркеров. Текст между маркерами оценивает только части внутри выбранных символов маркеров.",
      "options": [
        {
          "value": "fulltext",
          "label": "Весь текст"
        },
        {
          "value": "marked",
          "label": "Текст между маркерами [ ]"
        }
      ]
    },
    {
      "name": "showEvaluatedParts",
      "type": "boolean",
      "label": "Показывать оцениваемую часть на светло-синем фоне",
      "description": "Показывает в режиме учащегося содержимое между выбранными маркерами на светло-синем фоне до проверки.",
      "default": false
    },
    {
      "name": "behaviour",
      "type": "group",
      "label": "Настройки поведения",
      "importance": "low",
      "fields": [
        {
          "name": "delimiters",
          "type": "select",
          "label": "Маркеры",
