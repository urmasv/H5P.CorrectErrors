          "default": "[]",
          "options": [
            {
              "value": "[]",
              "label": "[ ]  –  [ответ]"
            },
            {
              "value": "{}",
              "label": "{ }  –  {ответ}"
            },
            {
              "value": "##",
              "label": "# #  –  #ответ#"
            },
            {
              "value": "@@",
              "label": "@ @  –  @ответ@"
            },
            {
              "value": "*",
              "label": "* *  –  *ответ*"
            }
          ]
        },
        {
          "name": "optionSeparator",
          "type": "text",
          "label": "Разделитель альтернативных ответов",
          "description": "Используйте его внутри отмеченного ответа, например [кот|собака].",
          "default": "|",
          "maxLength": 4,
          "widget": "textarea"
        },
        {
          "name": "enableRetry",
          "type": "boolean",
          "label": "Разрешить повторную попытку",
          "default": true
        },
        {
          "name": "showCorrectTextAfterCheck",
          "type": "boolean",
          "label": "Показывать правильный текст после проверки",
          "default": true
        }
      ]
    },
